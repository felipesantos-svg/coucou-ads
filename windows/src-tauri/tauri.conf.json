{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cocou Ads",
  "version": "0.2.0",
  "identifier": "app.cocouads.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    },
    "windows": [
      {
        "label": "island",
        "title": "Cocou Ads",
        "url": "index.html",
        "width": 240,
        "height": 6,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": true,
        "center": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --disable-gpu"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../target/release/cocou-ads-hook.exe": "cocou-ads-hook.exe",
      "../../LICENSE": "licenses/Coucou-MIT.txt",
      "../../THIRD-PARTY-NOTICES.md": "licenses/THIRD-PARTY-NOTICES.md",
      "knowledge/claude-ads/LICENSE": "licenses/Claude-Ads-MIT.txt",
      "../public/provider-icons/LICENSE": "licenses/LobeHub-MIT.txt",
      "../public/provider-icons/CODENOTCH-LICENSE": "licenses/CodeNotch-MIT.txt"
    },
    "copyright": "© Louis Raille",
    "licenseFile": "../../LICENSE",
    "category": "DeveloperTool",
    "shortDescription": "Assistente de tráfego, agenda e limites de IA no desktop",
    "longDescription": "Cocou Ads é uma adaptação independente do Coucou de Louis Raillé, com leitura de Meta Ads, alertas por campanha, Google Agenda e medidores de uso de IA.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
